<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="pyfb2viewer"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="pyFB2"/>
    <License Value="MIT"/>
    <Description Value="FB2 viewer components: TFb2Viewer (FB2 to HTML via THtmlViewer), TFb2Outline (heading tree with navigation) and TFb2ViewerToolbar (reader toolbar: history, font size, find, print). Requires the HtmlViewer package (FrameViewer09) and printer4lazarus. NOTE: the package is named pyfb2viewer (not fb2viewer) because Lazarus regenerates a package unit named after the package, which would overwrite the component unit fb2viewer.pas."/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="ObjFPC"/>
          <CStyleOperator Value="False"/>
          <CPPInline Value="False"/>
          <UseAnsiStrings Value="False"/>
        </SyntaxOptions>
      </Parsing>
    </CompilerOptions>
    <Version Major="1" Minor="0"/>
    <Files Count="12">
      <Item1>
        <Filename Value="fb2_structures.pas"/>
        <UnitName Value="fb2_structures"/>
      </Item1>
      <Item2>
        <Filename Value="fb2_parser.pas"/>
        <UnitName Value="fb2_parser"/>
      </Item2>
      <Item3>
        <Filename Value="fb2_html.pas"/>
        <UnitName Value="fb2_html"/>
      </Item3>
      <Item4>
        <Filename Value="fb2viewer.pas"/>
        <UnitName Value="fb2viewer"/>
      </Item4>
      <Item5>
        <Filename Value="fb2outline.pas"/>
        <UnitName Value="fb2outline"/>
      </Item5>
      <Item6>
        <Filename Value="fb2viewertoolbar.pas"/>
        <UnitName Value="fb2viewertoolbar"/>
      </Item6>
      <Item7>
        <Filename Value="fb2statusbar.pas"/>
        <UnitName Value="fb2statusbar"/>
      </Item7>
      <Item8>
        <Filename Value="fb2metadatapanel.pas"/>
        <UnitName Value="fb2metadatapanel"/>
      </Item8>
      <Item9>
        <Filename Value="fb2viewer_reg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="fb2viewer_reg"/>
      </Item9>
      <Item10>
        <Filename Value="fb2renamelist.pas"/>
        <UnitName Value="fb2renamelist"/>
      </Item10>
      <Item11>
        <Filename Value="fb2filetreeview.pas"/>
        <UnitName Value="fb2filetreeview"/>
      </Item11>
      <Item12>
        <Filename Value="fb2filelistview.pas"/>
        <UnitName Value="fb2filelistview"/>
      </Item12>
    </Files>
    <CompatibilityMode Value="True"/>
    <RequiredPkgs Count="3">
      <Item1>
        <PackageName Value="LCL"/>
      </Item1>
      <Item2>
        <PackageName Value="FrameViewer09"/>
      </Item2>
      <Item3>
        <PackageName Value="printer4lazarus"/>
      </Item3>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
